A cross build leaves ac_sys_release empty, so Darwin matched none of the
release patterns and got _XOPEN_SOURCE/_POSIX_C_SOURCE, which hide sendfile,
getpagesize and friends. Native macOS builds never define them.

--- a/configure
+++ b/configure
@@ -4704,7 +4704,7 @@ printf "%s\n" "#define _BSD_SOURCE 1" >>confdefs.h
   # has no effect, don't bother defining them
   Darwin/[6789].*)
     define_xopen_source=no;;
-  Darwin/[12][0-9].*)
+  Darwin/[12][0-9].* | Darwin/)
     define_xopen_source=no;;
   # On iOS, defining _POSIX_C_SOURCE also disables platform specific features.
   iOS/*)
--- a/configure.ac
+++ b/configure.ac
@@ -881,7 +881,7 @@ case $ac_sys_system/$ac_sys_release in
   # has no effect, don't bother defining them
   Darwin/@<:@6789@:>@.*)
     define_xopen_source=no;;
-  Darwin/@<:@[12]@:>@@<:@0-9@:>@.*)
+  Darwin/@<:@[12]@:>@@<:@0-9@:>@.* | Darwin/)
     define_xopen_source=no;;
   # On iOS, defining _POSIX_C_SOURCE also disables platform specific features.
   iOS/*)
