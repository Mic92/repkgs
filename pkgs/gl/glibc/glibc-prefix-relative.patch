diff --git a/include/libc-prefix.h b/include/libc-prefix.h
new file mode 100644
--- /dev/null
+++ b/include/libc-prefix.h
@@ -0,0 +1,18 @@
+#ifndef _LIBC_PREFIX_H
+#define _LIBC_PREFIX_H
+
+#include <stddef.h>
+#include <limits.h>
+
+/* CONFIGURED with $(prefix) replaced by where the running libc.so is
+   installed, cached in BUF.  Other paths come back as is; the static libc
+   gets a directory that cannot exist.  */
+extern const char *__libc_prefix_path (const char *configured,
+				       char *buf, size_t len)
+  attribute_hidden;
+
+#define LIBC_PREFIX_PATH(configured) \
+  ({ static char __buf[PATH_MAX];					\
+     __libc_prefix_path (configured, __buf, sizeof __buf); })
+
+#endif
