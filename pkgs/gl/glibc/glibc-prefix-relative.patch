new file mode 100644
--- /dev/null
+++ b/misc/libc-prefix.c
@@ -0,0 +1,81 @@
+/* Installation directories relative to the loaded libc.so.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+
+   The GNU C Library is free software; you can redistribute it and/or
+   modify it under the terms of the GNU Lesser General Public
+   License as published by the Free Software Foundation; either
+   version 2.1 of the License, or (at your option) any later version.
+
+   The GNU C Library is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   Lesser General Public License for more details.
+
+   You should have received a copy of the GNU Lesser General Public
+   License along with the GNU C Library; if not, see
+   <https://www.gnu.org/licenses/>.  */
+
+#include <atomic.h>
+#include <dlfcn.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <string.h>
+#include <libc-prefix.h>
+
+/* Not the configured $(prefix): it may not exist at run time and could be
+   planted, and gconv modules are dlopen'ed from it.  */
+#define NO_PREFIX "/dev/null"
+
+/* Two components up from the canonical path of lib/libc.so.6.  */
+static size_t
+runtime_prefix (char *buf, size_t len)
+{
+#ifdef SHARED
+  Dl_info info;
+  char real[PATH_MAX];
+  if (!_dl_addr ((const void *) &runtime_prefix, &info, NULL, NULL)
+      || info.dli_fname == NULL || __realpath (info.dli_fname, real) == NULL)
+    return 0;
+  char *end = real + strlen (real);
+  for (int up = 0; up < 2; ++up)
+    while (end > real && *--end != '/')
+      ;
+  size_t n = end - real;
+  if (n == 0 || n >= len)
+    return 0;
+  memcpy (buf, real, n);
+  buf[n] = '\0';
+  return n;
+#else
+  return 0;
+#endif
+}
+
+const char *
+__libc_prefix_path (const char *configured, char *buf, size_t len)
+{
+  size_t plen = strlen (PREFIX);
+  if (strncmp (configured, PREFIX, plen) != 0
+      || (configured[plen] != '/' && configured[plen] != '\0'))
+    return configured;
+
+  /* buf[0] is written last.  */
+  if (atomic_load_acquire (&buf[0]) != '\0')
+    return buf;
+
+  char tmp[PATH_MAX];
+  size_t n = runtime_prefix (tmp, sizeof tmp);
+  if (n == 0)
+    {
+      n = strlen (NO_PREFIX);
+      memcpy (tmp, NO_PREFIX, n + 1);
+    }
+  size_t rest = strlen (configured + plen);
+  if (n + rest >= len || n + rest >= sizeof tmp)
+    return NO_PREFIX;
+  memcpy (tmp + n, configured + plen, rest + 1);
+  memcpy (buf + 1, tmp + 1, n + rest);
+  atomic_store_release (&buf[0], tmp[0]);
+  return buf;
+}
