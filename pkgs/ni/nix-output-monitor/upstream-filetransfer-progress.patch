 printTransferProgress :: [ActivityProgress] -> (Maybe Double, [Text])
 printTransferProgress = \case
   [] -> (Nothing, [])
-  ap ->
-    ( Just $ intToDouble done' / intToDouble expected
-    , [printBytes done' <> "/" <> printBytes expected]
