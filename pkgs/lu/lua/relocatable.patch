 */
 
 #include <dlfcn.h>
+#include <reloc.h>
+
+/*
+** LUA_EXEC_DIR ('!') in the default paths is the prefix this Lua lives under, as on Windows,
+** found from the running binary or library.
+*/
+#undef setprogdir
+static void setprogdir (lua_State *L) {
+  luaL_gsub(L, lua_tostring(L, -1), LUA_EXEC_DIR "/", RELOC("../"));
+  lua_remove(L, -2);  /* remove original string */
+}
 
