#!/usr/bin/env nu
# uptrack: upstream tracking for package trees. docs/uptrack.md

use pipeline.nu
use locks.nu
use purl.nu *

# `--all` also yields packages with nothing to poll (in-tree source, frozen upstream)
def selected [names: list<string>, --all]: nothing -> table {
  let all = pipeline discover (pipeline root) | where { $all or $in.tracked }
  let missing = $names | where $it not-in $all.name
  if ($missing | is-not-empty) { error make {msg: $"no sources.toml for ($missing | str join ', ')"} }
  if ($names | is-empty) { $all } else { $all | where name in $names }
}

def planned [names: list<string>, prerelease: bool]: nothing -> table {
  pipeline decide (pipeline resolve (selected $names)) --prerelease=$prerelease
}

def main []: nothing -> nothing { help main }

# parse and validate every sources.toml
def "main list" [
  ...names: string # packages, default all
]: nothing -> table {
  selected $names | each {|r| {name: $r.name, purl: $r.upstream.purl, version: $r.pin.version?, hooks: ($r.hooks | str join ' ')} }
}

# resolve and decide, write nothing. Exits 10 when updates are pending
def "main check" [
  ...names: string # packages, default all
  --json # plan entries instead of tables
  --prerelease # accept pre-releases
]: nothing -> oneof<string, nothing> {
  let plan = planned $names $prerelease
  if $json { return ($plan | to json) }
  let errs = $plan | where to == null and note != null | select name from note
  let ups = $plan | where to != null | select name from to note
  if ($errs | is-not-empty) { print -e ($errs | table -i false) }
  if ($ups | is-not-empty) { print -e ($ups | table -i false) }
  print -e $"($plan | length) checked, ($ups | length) pending, ($errs | length) problems"
  if ($ups | is-not-empty) { exit 10 }
}

# prefetch and write hash + [pin] (+ hook files, locks) for pending updates. `verify` builds them
def "main apply" [
  ...names: string # packages, default all
  --plan: path # apply a saved `check --json` instead of resolving
  --prerelease # accept pre-releases
]: nothing -> table {
  let plan = if $plan != null { open $plan } else { planned $names $prerelease }
  $plan | where to != null | each {|e|
    print -e $"($e.name): ($e.from) → ($e.to)"
    pipeline apply $e
    locks add $e | ignore
    # a solver input changed (the compiler a version set was solved for): redo every lock of that ecosystem
    for eco in ($e.upstream.relocks? | default []) {
      for p in (selected --all [] | where { $in.locks | get -o $eco | is-not-empty }) { print -e $"  relock ($p.name)"; locks add $p | ignore }
    }
    $e | select name from to
  }
}

# build packages at their current pin (after a manual edit, or to re-check)
def "main verify" [
  ...names: string # packages, default all
]: nothing -> table {
  selected $names | each {|p|
    let v = pipeline verify $p
    {name: $p.name, verified: $v.verified, took: $v.took, closure: ($v.closure? | default null)}
  }
}

# re-prefetch sources at the current pin, e.g. after editing a url
def "main rehash" [
  ...names: string # packages, default all
]: nothing -> nothing {
  for p in (selected --all $names) {
    print -e $p.name
    try { pipeline rehash $p } catch {|e| print -e $"  failed: ($e.msg)" }
  }
}

# record dependency hashes in locks/<eco>.toml for packages with [locks], at their current pin
def "main lock" [
  ...names: string # packages, default all with [locks]
  --prune # afterwards drop entries no package uses any more (looks at every package, ignores names)
]: nothing -> nothing {
  let pkgs = (selected --all (if $prune { [] } else { $names }) | where { $in.locks | is-not-empty })
  # [{eco, keys}] per package -> every key any package uses, per ecosystem
  let used = ($pkgs | each {|p| print -e $p.name; locks add $p } | flatten | group-by eco --to-table
    | each {|g| {eco: $g.eco, keys: ($g.items.keys | flatten | uniq)} })
  if $prune { locks prune $used }
}

# write a new sources.toml and pin it to the newest version upstream lists
def "main init" [
  dir: path # package directory
  purl: string # pkg:github/owner/repo, pkg:pypi/name, pkg:gnu/name, pkg:generic/name?url=…
  url: string # source template with {version} {version_} {major} {minor} {tag}
  --allow: string # version range to stay in, e.g. "==3.12.*"
]: nothing -> nothing {
  purl parse $purl
  let f = $dir | path join sources.toml
  if ($f | path exists) { error make {msg: $"($f) exists"} }
  mkdir $dir
  {upstream: ({purl: $purl} | merge (if $allow != null { {allow: $allow} } else { {} })), source: [{key: default, url: $url}]} | save $f
  let e = planned [($dir | path basename)] false | first
  if $e.to == null { rm $f; error make {msg: $"($purl): ($e.note)"} }
  pipeline apply $e
  print -e $"($f): ($e.to)"
}
