--- /dev/null
+++ b/cnf/hints/darwin
@@ -0,0 +1,24 @@
+# Darwin syscalls
+d_voidsig='define'
+d_nanosleep='define'
+d_clock_gettime='define'
+d_clock_getres='define'
+d_clock='define'
+
+dlext='bundle'
+ldlibpthname='DYLD_LIBRARY_PATH'
+usemallocwrap='define'
+usenm='false'
+
+# poll() on a tty/devnull misbehaves, perl's hints/darwin.sh turns it off too
+d_poll='undef'
+i_poll='undef'
+d_syscall='undef'
+d_mkostemp='undef'
+
+libswanted='m dl'
+
+st_ino_sign=1
+st_ino_size=8
+
+d_fcntl_can_lock='define'
