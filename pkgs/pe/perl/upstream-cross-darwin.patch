@@ -0,0 +1,12 @@
+Time::HiRes picks hints/<os>.pl by the running perl's $^O, under perl-cross that is the
+build machine's (linux.pl adds -lrt, which a Darwin target does not have).
+
+--- a/dist/Time-HiRes/Makefile.PL
++++ b/dist/Time-HiRes/Makefile.PL
+@@ -390,5 +390,5 @@
+ 
+ sub init {
+-    my $hints = File::Spec->catfile("hints", "$^O.pl");
++    my $hints = File::Spec->catfile("hints", "$Config{osname}.pl");
+     if (-f $hints) {
+         print "Using hints $hints...\n";
