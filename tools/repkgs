#!/usr/bin/env nu
# One entry point for working on the set. Every subcommand is a thin wrapper that ends in
# nix-build, nix, uptrack, jigd or treefmt: `repkgs <cmd> --help` shows what it runs.

const INSIDE = "/nix/var/nix/jigd/socket"

def root []: nothing -> string { $env.CURRENT_FILE | path expand | path dirname -n 2 }

# --for as nix sees it: on a command line, and inside an expression
def platform-arg [p]: nothing -> list<string> { if $p == null { [] } else { [--argstr platform $p] } }
def set-expr [p]: nothing -> string { $"\(import (root) (if $p == null { "{ }" } else { $"{ platform = \"($p)\"; }" })\)" }

def fail [msg: string]: nothing -> error { error make --unspanned {msg: $msg} }

# one nix expression to JSON. Nix's own errors (unknown package or platform, a package.nix
# mistake) are its last `error:` line, not the trace through our query expression
def eval [expr: string]: nothing -> any {
  let r = (^nix-instantiate --eval --strict --json --expr $expr | complete)
  if $r.exit_code != 0 {
    fail ($r.stderr | lines | where $it =~ '^\s*error:' | last | default $r.stderr | str replace -r '^\s*error:\s*' "")
  }
  $r.stdout | from json
}

# the package <attr> of the set for platform p, as an expression. `s.${"7zip"}` parses where
# s.7zip does not, and a typo names its neighbours instead of nix's attribute trace
def pkg-expr [attr: string, p]: nothing -> string {
  let n = ($attr | to json)
  $"\(let s = (set-expr $p); n = ($n); in s.${n} or \(builtins.throw \"no package ${n}, near: ${toString \(builtins.filter \(a: builtins.substring 0 2 a == builtins.substring 0 2 n\) \(builtins.attrNames s\)\)}\"\)\)"
}

# a socket file something is listening on (a crashed jigd leaves the file behind)
def is-socket [p: string]: nothing -> bool {
  ($p | path exists) and (ls -D $p | get 0.type) == "socket" and (open --raw /proc/net/unix | str contains $" ($p | path expand)\n")
}

# under /tmp, not XDG_RUNTIME_DIR: the nix build user has to reach it through extra-sandbox-paths
def jigd-dir []: nothing -> string { $"/tmp/jigd-(id -u)" }

def jigd-socket []: nothing -> any {
  [$env.JIGD_SOCK? $INSIDE $"(jigd-dir)/socket"] | compact | where {|p| is-socket $p } | get 0?
}

# maps the jigd socket into the sandbox (trusted user) and keeps the build local, a remote has no cache
def cache-args []: nothing -> list<string> {
  let sock = (jigd-socket)
  if $sock == null {
    print -e "repkgs: no jigd socket, building uncached (repkgs cache start)"
    []
  } else {
    [--option extra-sandbox-paths $"($INSIDE)=($sock)" --builders ""]
  }
}

def drv [attr: string, p]: nothing -> string { eval $"(pkg-expr $attr $p).drvPath" }

def main []: nothing -> nothing { help main }

# build packages through the compile cache
def "main build" [
  --for: string # platform, e.g. aarch64-linux, x86_64-windows
  ...attrs: string # package attributes (jq, jq.tests)
]: nothing -> nothing {
  if ($attrs | is-empty) { fail "repkgs build <attr>…, or nix-build -A ci for the whole set" }
  ^nix-build (root) --no-out-link --log-format bar-with-logs ...(cache-args) ...(platform-arg $for) ...($attrs | each {|a| [-A $a] } | flatten)
}

# build <pkg>.tests (tests.separate packages), or the package itself when it tests in-build
def "main test" [
  --for: string # platform
  ...attrs: string
]: nothing -> nothing {
  let targets = ($attrs | each {|a| if (eval $"(pkg-expr $a $for) ? tests") { $"($a).tests" } else { $a } })
  main build --for=$for ...$targets
}

# the build log of a package's derivation
def "main log" [
  --for: string # platform
  attr: string
]: nothing -> nothing {
  let d = (drv $attr $for)
  let r = (^nix log $d | complete)
  if $r.exit_code != 0 { fail $"no local log for ($d): built elsewhere or substituted, `repkgs build` it here first" }
  print $r.stdout
}

# a shell with the package's build environment (nix-shell on its derivation)
def "main shell" [
  --for: string # platform
  attr: string
]: nothing -> nothing {
  ^nix-shell (drv $attr $for)
}

# package names for a platform, or the ones it does not support and why
def "main list" [
  --for: string # platform
  --unsupported # show what `supported` filters out, with the reason
  --json (-j) # machine-readable
]: nothing -> any {
  let set = (set-expr $for)
  let rows = (if $unsupported {
    eval $"let s = ($set); in map \(n: { name = n; reason = s.${n}.unsupportedReason; }\) \(builtins.filter \(n: !s.${n}.supported\) \(builtins.attrNames s\)\)"
  } else {
    eval $"builtins.attrNames ($set)"
  })
  if $json { $rows | to json } else if $unsupported { $rows } else { $rows | wrap name }
}

# version, platform support, build systems and features of one package without building it
def "main info" [
  --for: string # platform
  --json (-j) # machine-readable: the full record
  attr: string
]: nothing -> any {
  let p = (eval $"let p = (pkg-expr $attr $for); in { name = p.pname; version = p.version or null; platform = p.platform; supported = p.supported; reason = p.unsupportedReason; uses = p.args.uses or []; features = builtins.mapAttrs \(n: d: d // { value = p.features.${n}; }\) \(p.args.features or {}\); }")
  if $json { return ($p | to json) }
  print ({name: $p.name, version: $p.version, platform: $p.platform, uses: ($p.uses | str join " ")}
    | merge (if $p.supported { {} } else { {unsupported: $p.reason} }))
  if ($p.features | is-not-empty) {
    print ($p.features | transpose feature f | each {|r| {feature: $r.feature, value: ($r.f.value | to nuon), values: ($r.f.values? | default [] | str join " | "), doc: ($r.f.doc? | default "")} } | table -i false)
  }
}

# the options every build system accepts (<name>.* in a package.nix)
def "main options" [
  --json (-j) # machine-readable: { <system> = { <option> = { type, default, doc } } }
  ...systems: string # build systems, default all
]: nothing -> any {
  let all = (eval $"\(import (root)/nix/options.nix {}\).options")
  let names = (if ($systems | is-empty) { $all | columns } else { $systems | uniq })
  let unknown = ($names | where $it not-in ($all | columns))
  if ($unknown | is-not-empty) { fail $"no build system '($unknown | str join ' ')', have: ($all | columns | str join ' ')" }
  if $json { return ($all | select ...$names | to json) }
  for bs in $names {
    print $"## ($bs)\n"
    print ($all | get $bs | transpose option v | each {|r| {option: $"`($bs).($r.option)`", type: ($r.v.type | str join " | " | str replace "set | string" package), default: (if ($r.v.type | str join " " | str contains "set string") { "lock file" } else { $r.v.default | to nuon }), meaning: $r.v.doc} } | to md --pretty)
    print ""
  }
}

# a new package directory with sources.toml from a purl and url template (uptrack init)
def "main new" [
  name: string # attribute name
  purl: string # pkg:github/owner/repo, pkg:pypi/name, pkg:gnu/name, …
  url: string # source url with {version} {tag} {major} {minor}
]: nothing -> nothing {
  let dir = $"(root)/pkgs/($name | str substring 0..<2)/($name)"
  if ($dir | path exists) { fail $"($dir) exists" }
  try { ^$"(root)/pkgs/up/uptrack/src/uptrack" init $dir $purl $url } catch {
    rm -rf $dir
    fail $"uptrack init failed for ($purl), nothing written"
  }
  if not ($"($dir)/package.nix" | path exists) {
    $"{\n  package,\n  pkgs,\n}:\npackage {\n  name = \"($name)\";\n  uses = [ \"autotools\" ];\n}\n" | save $"($dir)/package.nix"
  }
  print -e $"($dir): edit package.nix, then repkgs build ($name)"
}

# versions and lock tables: uptrack check | apply | lock | verify | rehash | list
def --wrapped "main update" [...args: string]: nothing -> nothing {
  ^$"(root)/pkgs/up/uptrack/src/uptrack" ...$args
}

# rebuild and compare against the store (nix-build --check)
def "main repro" [
  --for: string # platform
  ...attrs: string # default: zlib xz pcre2 jq sqlite ncurses
]: nothing -> table {
  let attrs = (if ($attrs | is-empty) { [zlib xz pcre2 jq sqlite ncurses] } else { $attrs })
  $attrs | each {|a|
    let build = (^nix-build (root) -A $a --no-out-link ...(platform-arg $for) | complete)
    if $build.exit_code != 0 { return {attr: $a, status: build-failed} }
    let check = (^nix-build (root) -A $a --no-out-link --check --keep-failed ...(platform-arg $for) | complete)
    {attr: $a, status: (if $check.exit_code == 0 { "reproducible" } else if $check.stderr =~ "may not be deterministic|differs" { "DIFFERS" } else { "check-failed" })}
  }
}

# the compile cache daemon: start | stop | status
def "main cache" [
  action: string # start, stop or status
  --size: int = 50 # GiB before whole packs are evicted (start)
]: nothing -> nothing {
  let dir = (jigd-dir)
  let sock = $"($dir)/socket"
  let pidfile = $"($dir)/pid"
  match $action {
    "start" => {
      if (is-socket $sock) { print -e $"jigd already serving ($sock)"; return }
      mkdir $dir
      rm -f $sock
      let jigd = (^nix-build (root) -A jigd --no-out-link | str trim)
      let pid = (^sh -c $"JIGD_SIZE=($size) setsid ($jigd)/bin/jigd ($sock) >($dir)/log 2>&1 & echo $!" | str trim)
      $pid | save -f $pidfile
      print -e $"jigd pid ($pid), socket ($sock), log ($dir)/log"
    }
    "stop" => { if ($pidfile | path exists) { ^kill (open --raw $pidfile | str trim); rm -f $pidfile $sock } }
    "status" => {
      let s = (jigd-socket)
      if $s == null { print "jigd: not running"; return }
      print $"jigd: ($s)"
      if ($"($dir)/log" | path exists) { ^tail -n 3 $"($dir)/log" }
    }
    _ => { fail "repkgs cache start|stop|status" }
  }
}

# build seed nars on this machine and upload them (pkgs/se/seed/upload.nu)
def --wrapped "main seed" [...args: string]: nothing -> nothing {
  ^$"(root)/pkgs/se/seed/upload.nu" ...$args
}

# cross build <pkg> for cpus upstream has no binaries for and upload it as <pkg>-bootstrap's source (tools/upload-bootstrap.nu)
def --wrapped "main bootstrap" [...args: string]: nothing -> nothing {
  ^$"(root)/tools/upload-bootstrap.nu" ...$args
}

# format and lint the tree (treefmt)
def --wrapped "main fmt" [...args: string]: nothing -> nothing {
  cd (root)
  ^treefmt ...$args
}
