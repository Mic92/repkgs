#!/usr/bin/env nu
# Rebuild packages and compare against what the store already has. With CA derivations a
# non-reproducible build shows up as `nix-build --check` failing (output hash differs).
def main [
  --platform: string = ""  # e.g. aarch64-linux
  ...attrs: string         # package attributes, default: a small fixed set
]: nothing -> nothing {
  let attrs = if ($attrs | is-empty) { [zlib xz pcre2 jq sqlite ncurses] } else { $attrs }
  let plat = if $platform == "" { [] } else { [--argstr platform $platform] }
  let root = ($env.FILE_PWD | path dirname)
  let results = ($attrs | each {|a|
    let build = (^nix-build $root -A $a --no-out-link ...$plat | complete)
    if $build.exit_code != 0 { return {attr: $a, status: "build-failed"} }
    let check = (^nix-build $root -A $a --no-out-link --check --keep-failed ...$plat | complete)
    let status = if $check.exit_code == 0 { "reproducible" } else if ($check.stderr =~ "may not be deterministic|differs") { "DIFFERS" } else { "check-failed" }
    # --keep-failed leaves the second output at <path>.check for diffoscope
    let kept = ($check.stderr | parse -r "(?P<p>/nix/store/\\S+\\.check)" | get p? | default [] | first 1)
    {attr: $a, status: $status, diff: ($kept | get 0? | default "")}
  })
  print ($results | table)
  if ($results | any { $in.status != "reproducible" }) { exit 1 }
}
