#!/usr/bin/env nu
# nix-build through the local compile cache: maps the jigd socket into the sandbox (needs a
# trusted user) and keeps the build on this machine, since a remote builder has no cache.
#   tools/build -A jq            any nix-build arguments
#   JIGD_SOCK=… tools/build -A jq

# in the sandbox: a root-owned location on every OS Nix runs on. On the host: the same if the
# daemon runs as a service, else the user's private runtime dir (never world-writable /tmp:
# whoever creates the socket first serves every build its objects)
const inside = "/nix/var/nix/jigd/socket"

def is-socket [p: string]: nothing -> bool { ($p | path exists) and (ls -D $p | get 0.type) == "socket" }

def --wrapped main [...args: string] {
  cd $"($env.FILE_PWD)/.."
  let sock = [$env.JIGD_SOCK? $inside $"($env.XDG_RUNTIME_DIR? | default '/nonexistent')/jigd/socket"]
    | compact | where { is-socket $in } | get 0?
  let cache = if $sock != null {
    [--option extra-sandbox-paths $"($inside)=($sock)" --builders ""]
  } else {
    print -e $"tools/build: no jigd socket at ($inside) or $XDG_RUNTIME_DIR/jigd/socket, building uncached"
    []
  }
  exec nix-build . --no-out-link --log-format bar-with-logs ...$cache ...$args
}
