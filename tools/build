#!/bin/sh
# nix-build through the local compile cache: maps the pkgs-cache socket into the sandbox (needs a
# trusted user) and keeps the build on this machine, since a remote builder has no cache.
#   tools/build -A jq            any nix-build arguments
#   PKGS_CACHE_SOCK=… tools/build -A jq
set -eu
cd "$(dirname "$0")/.."
sock=${PKGS_CACHE_SOCK:-${XDG_RUNTIME_DIR:-/tmp}/pkgs-cache.sock}
[ -S "$sock" ] || sock=/tmp/pkgs-cache.sock
if [ -S "$sock" ]; then
  set -- --option extra-sandbox-paths "/run/pkgs-cache.sock=$sock" --builders "" "$@"
else
  echo "tools/build: no pkgs-cache socket at $sock, building uncached" >&2
fi
exec nix-build . --no-out-link --log-format bar-with-logs "$@"
